{
  "name": "bbtp",
  "version": "1.0.0",
  "description": "BBTP Launcher application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "admin": "electron admin_main.js",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "firebase": "^12.8.0",
    "idb": "^8.0.3"
  },
  "build": {
    "appId": "com.student.nous",
    "productName": "Nous",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!**/*.psd",
      "!admin.html",
      "!admin_main.js"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "logo.png"
    }
  }
}
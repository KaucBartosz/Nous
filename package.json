{
  "name": "nous",
  "version": "1.2.3",
  "description": "Nous Launcher application",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaucBartosz/Nous.git"
  },
  "scripts": {
    "start": "electron .",
    "admin": "electron admin_main.js",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64 -c.linux.target=zip",
    "dist:linux:ci": "electron-builder --linux --x64 -c.linux.target=AppImage",
    "dist:mac": "electron-builder --mac --universal",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e-electron.spec.js",
    "test:e2e:ui": "playwright test tests/e2e-electron.spec.js --ui",
    "test:e2e:debug": "playwright test tests/e2e-electron.spec.js --debug",
    "test:e2e:report": "playwright show-report"
  },
  "keywords": [],
  "author": "KaucBartosz <112867979+KaucBartosz@users.noreply.github.com>",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.0.18",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.7.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.1.7",
    "firebase": "^12.8.0",
    "idb": "^8.0.3"
  },
  "build": {
    "appId": "com.student.nous",
    "productName": "Nous",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "KaucBartosz",
        "repo": "Nous",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "deleteAppDataOnUninstall": true,
      "differentialPackage": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "logo.png"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!**/*.psd",
      "!admin.html",
      "!admin_main.js",
      "!.github/*",
      "!coverage/*",
      "!tests/*",
      "!test-results/*",
      "!playwright-report/*",
      "!*.spec.js"
    ]
  }
}

graph TD
    %% Styling and Classes
    classDef default fill:#ffffff,stroke:#718096,stroke-width:1px,color:#2d3748;
    classDef process fill:#e3f2fd,stroke:#1e88e5,stroke-width:1.5px,color:#0d47a1;
    classDef decision fill:#fff3e0,stroke:#fb8c00,stroke-width:1.5px,color:#e65100;
    classDef storage fill:#e8f5e9,stroke:#43a047,stroke-width:1.5px,color:#1b5e20;
    classDef event fill:#f3e5f5,stroke:#8e24aa,stroke-width:1.5px,color:#4a148c;
    classDef system fill:#ffffff,stroke:#718096,stroke-width:2px;

    Start([Rozpoczęcie badania]) ::: system
    
    Start --> Run[Przeprowadzenie testu<br/><i>(środowisko Web lub HPM)</i>]:::process
    Run --> EncryptLocal[Zabezpieczenie lokalne<br/><i>(Szyfrowanie AES-GCM-256 + HMAC-SHA256)</i>]:::process
    EncryptLocal --> SaveLocal[(Zapis w bazie lokalnej IndexedDB<br/><i>status: 'PENDING'</i>)]:::storage
    
    SaveLocal --> CheckNet{Czy aplikacja posiada<br/>połączenie sieciowe?}:::decision
    
    %% Offline path
    CheckNet -->|Nie / Offline| OfflineQueue[Kolejkowanie rekordu w IndexedDB<br/><i>(oczekiwanie w tle)</i>]:::process
    OfflineQueue --> WaitOnline{Wykryto zdarzenie online?<br/><i>window.online</i>}:::event
    WaitOnline -->|Nie| OfflineQueue
    WaitOnline -->|Tak| CheckAuth{Czy status konta to<br/>APPROVED / ADMIN?}:::decision
    
    %% Online path
    CheckNet -->|Tak / Online| CheckAuth
    
    %% Authentication Gate
    CheckAuth -->|Nie| BlockSync[Zablokowanie synchronizacji<br/><i>(wymaga zatwierdzenia konta)</i>]:::process
    BlockSync --> EndOffline([Koniec - wynik pozostaje lokalnie]) ::: system
    
    CheckAuth -->|Tak| EncryptE2E[Szyfrowanie End-to-End<br/><i>(Klucz E2E AES-GCM z PIN/Backup)</i>]:::process
    
    EncryptE2E --> SendFS[Przesłanie szyfrogramu do Cloud Firestore]:::process
    SendFS --> ConfirmFS{Czy Firebase potwierdził<br/>poprawny zapis?}:::decision
    
    ConfirmFS -->|Tak / Sukces| UpdateStatus[Aktualizacja statusu w IndexedDB<br/><i>status: 'SYNCED'</i>]:::storage
    ConfirmFS -->|Nie / Błąd sieci| OfflineQueue
    
    UpdateStatus --> ShowToast[Powiadomienie badacza<br/><i>(Wizualny Toast w Launcherze)</i>]:::process
    ShowToast --> EndOnline([Koniec - status SYNCED]) ::: system

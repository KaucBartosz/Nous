rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Klient nie jest zaufany: reguły to druga warstwa obok szyfrowania E2E.
    // Even if the client is compromised, it cannot read or overwrite another
    // researcher's data — the server enforces ownership on every request.

    // Klucze E2E: tylko właściciel dokumentu może je czytać i zapisać.
    match /user_keys/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Wyniki badań: właściciel czyta własne wyniki i tworzy nowe dokumenty.
    match /results/{resultId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.researcher_uid;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.researcher_uid;
    }

    // Wszystko inne — denies by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

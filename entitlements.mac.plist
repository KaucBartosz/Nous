<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Wymagane przez hardened runtime do uruchamiania podprocesów (Python HPM) -->
    <key>com.apple.security.cs.allow-jit</key>
    <false/>

    <!-- Pozwala na wykonywanie podpisanych plików wykonywalnych (standalone Python) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>

    <!-- Wymagane gdy app nie jest dystrybuowana przez App Store -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Dostęp do sieci (Firebase, GitHub releases) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Dostęp do pliku użytkownika (userData, ~/Library/Application Support) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Zapis do userData (pobrane testy, HPM engine) -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- Wymagane do spawn() podprocesów (Python HPM engine) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
  </dict>
</plist>
